{
  "name": "portfolio",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/api/src/**/*.{js,ts}": [
      "pnpm --filter @portfolio/api exec eslint --fix"
    ],
    "apps/web/src/**/*.{js,ts,tsx}": [
      "pnpm --filter @portfolio/web exec eslint --fix"
    ],
    "apps/web/src/**/*.{css,scss}": [
      "pnpm --filter @portfolio/web exec stylelint --fix"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.7.4",
    "turbo": "^2.9.16",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
