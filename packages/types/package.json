{
  "name": "@portfolio/types",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "mkdir -p src/generated && openapi-zod-client ../../apps/api/openapi.yaml -o src/generated/client.ts --export-schemas --strict-objects --additional-props-default-value false",
    "dev": "chokidar  ../../apps/api/openapi.yaml -c 'pnpm generate'",
    "build": "pnpm generate && tsc"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^26.0.0",
    "chokidar-cli": "^3.0.0",
    "openapi-zod-client": "^1.18.3"
  },
  "dependencies": {
    "@zodios/core": "^10.9.6",
    "zod": "^3.25.76"
  }
}
